#!/usr/bin/env bash
# Build the site and assert on the generated output. This is the test suite.
#   ./script/check          build + content assertions
#   ./script/check --links  also verify every external URL returns 200
set -uo pipefail
cd "$(dirname "$0")/.."

IMAGE=ruby:3.3-slim
VOLUME=jekyll-gems
PASS=0
FAIL=0

products() {
  echo "==> laying the products in from MLambda.Docs (script/products.py)"
  "$(command -v python3 || command -v python)" script/products.py "${DOCS_PRODUCTS:-../../docs/products}" || bad "products not laid in"
}

build() {
  echo "==> building site (docker: $IMAGE, source copied in — no bind mount)"
  docker volume create "$VOLUME" >/dev/null
  rm -rf _site
  local cid
  trap '[ -n "${cid:-}" ] && docker rm -f "$cid" >/dev/null 2>&1' EXIT
  cid=$(MSYS_NO_PATHCONV=1 docker create \
    -v "$VOLUME":/usr/local/bundle \
    -w /srv/jekyll "$IMAGE" \
    sh -c 'apt-get update -qq >/dev/null 2>&1 \
           && apt-get install -y -qq build-essential git >/dev/null 2>&1 \
           && bundle install --quiet \
           && bundle exec jekyll build')
  tar --exclude=.git --exclude=_site --exclude=_docs --exclude=.superpowers --exclude=.jekyll-cache -cf - . \
    | MSYS_NO_PATHCONV=1 docker cp - "$cid":/srv/jekyll
  MSYS_NO_PATHCONV=1 docker start -a "$cid" 2>&1 | tee /tmp/jekyll-build.log
  local status=${PIPESTATUS[0]}
  MSYS_NO_PATHCONV=1 docker cp "$cid":/srv/jekyll/_site ./_site >/dev/null 2>&1 || true
  MSYS_NO_PATHCONV=1 docker cp "$cid":/srv/jekyll/Gemfile.lock ./Gemfile.lock >/dev/null 2>&1 || true
  git diff --quiet -- Gemfile.lock 2>/dev/null || echo "note: Gemfile.lock was regenerated by the build; review and commit it"
  docker rm "$cid" >/dev/null
  if [ "$status" -ne 0 ]; then
    bad "build exited $status"
  elif grep -qiE "(Error|Warning|DEPRECATION|Liquid Exception)" /tmp/jekyll-build.log; then
    bad "build emitted warnings or errors (see /tmp/jekyll-build.log)"
  else
    ok "build clean"
  fi
}

ok()   { echo "PASS  $1"; PASS=$((PASS + 1)); }
bad()  { echo "FAIL  $1"; FAIL=$((FAIL + 1)); }

assert_file() {
  if [ -f "_site/$1" ]; then ok "exists: $1"; else bad "missing: $1"; fi
}

assert_contains() {
  if [ -f "_site/$1" ] && grep -qF -- "$2" "_site/$1"; then
    ok "$1 contains '$2'"
  else
    bad "$1 does NOT contain '$2'"
  fi
}

assert_absent() {
  if [ ! -f "_site/$1" ]; then
    bad "missing: $1 (cannot check absence of '$2')"
  elif grep -qF -- "$2" "_site/$1"; then
    bad "$1 must NOT contain '$2'"
  else
    ok "$1 free of '$2'"
  fi
}

assert_absent_everywhere() {
  if grep -rqF --binary-files=without-match -- "$1" _site 2>/dev/null; then
    bad "_site must NOT contain '$1' anywhere"
  else
    ok "_site free of '$1'"
  fi
}

assert_absent_regex_everywhere() {
  if grep -rqE --binary-files=without-match -- "$1" _site 2>/dev/null; then
    bad "_site must NOT match /$1/ anywhere"
  else
    ok "_site free of /$1/"
  fi
}

check_links() {
  echo "==> checking external links"
  local url code
  while read -r url; do
    code=$(curl -s -o /dev/null -w "%{http_code}" -L --max-time 20 "$url")
    case "$url" in
      *linkedin.com*)
        # LinkedIn returns 999 to non-browser clients; treat it as reachable.
        if [ "$code" = "200" ] || [ "$code" = "999" ]; then ok "$code $url"; else bad "$code $url"; fi ;;
      *)
        if [ "$code" = "200" ]; then ok "$code $url"; else bad "$code $url"; fi ;;
    esac
  done < <(grep -rhoE 'href="https?://[^"]+"' _site \
             | sed -E 's/href="//; s/"$//' \
             | grep -vE 'fonts\.(googleapis|gstatic)\.com' \
             | sort -u)
}

products
build

